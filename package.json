{
  "name": "desafio-tarefas-next",
  "version": "1.0.0",
  "private": true,
  "description": "Gerenciador de tarefas com Next.js 15, tRPC e armazenamento em memória.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
